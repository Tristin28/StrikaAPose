<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Strike A Pose</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #fff7fb, #f4f7ff);
      min-height: 100vh;
      color: #111;
    }

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 28px 34px;
    }

    header {
      text-align: center;
      margin-bottom: 28px;
    }

    h1 {
      font-family: 'Baloo 2', cursive;
      font-size: clamp(3rem, 5vw, 5rem);
      color: #000;
      letter-spacing: 1px;
      line-height: 1;
    }

    .subtitle {
      margin-top: 8px;
      font-size: 1rem;
      color: #444;
    }

    .main-layout {
      flex: 1;
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 28px;
      align-items: stretch;
    }

    .camera-panel,
    .control-panel {
      background: rgba(255, 255, 255, 0.85);
      border: 3px solid #111;
      border-radius: 28px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
    }

    .camera-panel {
      padding: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 520px;
    }

    .video-wrapper {
      width: 100%;
      height: 100%;
      min-height: 470px;
      border: 4px solid #111;
      border-radius: 22px;
      overflow: hidden;
      background: #dfe7f7;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    video,
    canvas {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .placeholder {
      position: absolute;
      text-align: center;
      color: #333;
      padding: 20px;
      font-size: 1.1rem;
      max-width: 80%;
    }

    .control-panel {
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
    }

    .panel-title {
      font-family: 'Baloo 2', cursive;
      font-size: 2rem;
      color: #000;
    }

    .panel-text {
      font-size: 1rem;
      line-height: 1.6;
      color: #333;
    }

    .button-group {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    button,
    .download-link {
      width: 100%;
      border: 3px solid #111;
      border-radius: 18px;
      padding: 15px 18px;
      font-size: 1rem;
      font-weight: 700;
      background: #fff;
      color: #111;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      text-align: center;
      text-decoration: none;
    }

    button:hover,
    .download-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      background: #f8f8f8;
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .captured-preview {
      border: 3px dashed #111;
      border-radius: 22px;
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #fafafa;
    }

    .captured-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .status {
      font-size: 0.95rem;
      color: #444;
      min-height: 22px;
    }

    @media (max-width: 980px) {
      .main-layout {
        grid-template-columns: 1fr;
      }

      .camera-panel {
        min-height: 420px;
      }

      .video-wrapper {
        min-height: 360px;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <h1>Strike A Pose</h1>
      <p class="subtitle">Open the camera, pose for the frame, and capture your photo.</p>
    </header>

    <main class="main-layout">
      <section class="camera-panel">
        <div class="video-wrapper">
          <video id="video" autoplay playsinline></video>
          <div class="placeholder" id="placeholder">Your live camera feed will appear here once you allow camera access.</div>
          <canvas id="canvas" style="display: none;"></canvas>
        </div>
      </section>

      <aside class="control-panel">
        <div>
          <h2 class="panel-title">Camera Controls</h2>
          <p class="panel-text">
            Use the buttons below to start your laptop camera, capture a photo, and save the image.
            This page focuses only on taking the photo for now, so the dataset matching part can be added later.
          </p>
        </div>

        <div class="button-group">
          <button id="startCameraBtn">Start Camera</button>
          <button id="captureBtn" disabled>Take Photo</button>
          <a id="saveBtn" class="download-link" href="#" download="strike-a-pose-photo.png" style="pointer-events: none; opacity: 0.6;">Save Photo</a>
        </div>

        <div>
          <p class="status" id="status">Camera not started yet.</p>
          <div class="captured-preview" id="previewBox">
            <span>No photo captured yet.</span>
          </div>
        </div>
      </aside>
    </main>
  </div>

  <script>
    const video = document.getElementById('video');
    const canvas = document.getElementById('canvas');
    const startCameraBtn = document.getElementById('startCameraBtn');
    const captureBtn = document.getElementById('captureBtn');
    const saveBtn = document.getElementById('saveBtn');
    const statusText = document.getElementById('status');
    const previewBox = document.getElementById('previewBox');
    const placeholder = document.getElementById('placeholder');

    let stream = null;

    async function startCamera() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: true,
          audio: false
        });

        video.srcObject = stream;
        captureBtn.disabled = false;
        statusText.textContent = 'Camera is live. You can take a photo now.';
        placeholder.style.display = 'none';
      } catch (error) {
        console.error('Camera access error:', error);
        statusText.textContent = 'Could not access the camera. Please allow camera permission.';
      }
    }

    function capturePhoto() {
      if (!stream) return;

      const width = video.videoWidth;
      const height = video.videoHeight;

      canvas.width = width;
      canvas.height = height;

      const context = canvas.getContext('2d');
      context.drawImage(video, 0, 0, width, height);

      const imageData = canvas.toDataURL('image/png');

      previewBox.innerHTML = `<img src="${imageData}" alt="Captured photo preview">`;
      saveBtn.href = imageData;
      saveBtn.style.pointerEvents = 'auto';
      saveBtn.style.opacity = '1';
      statusText.textContent = 'Photo captured successfully. You can now save it.';
    }

    startCameraBtn.addEventListener('click', startCamera);
    captureBtn.addEventListener('click', capturePhoto);
  </script>
</body>
</html>
